---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Not found">
  <div class="max-w-prose">
    <p class="text-sm text-faint">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink">Page not found</h1>
    <p class="mt-4 text-sm leading-relaxed text-body">
      There's nothing at this path.
    </p>

    <div class="mt-8">
      <Button href="/" variant="primary">
        <Icon 
          name="tabler:arrow-left" 
          class="h-4 w-4 transition-transform duration-150 ease-out group-hover:-translate-x-0.5" 
          aria-hidden="true" 
        />
        Go back home
      </Button>
    </div>
  </div>
</Base>