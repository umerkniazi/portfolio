---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site.ts';
import { projects, secondaryProjects } from '../data/projects.ts';
---

<Base title="Projects" description={`Projects built by ${site.name}.`}>
  <h1 class="text-3xl font-bold tracking-tight text-ink">Projects</h1>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-body">
    A selection of things I've built, mostly for myself, all open source.
  </p>

  <div class="mt-12 grid grid-cols-1 gap-y-14 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-16">
    {projects.map((project, idx) => (
      <ProjectCard {...project} index={idx + 1} headingLevel="h2" />
    ))}
  </div>

  <h2 class="mt-24 text-2xl font-bold tracking-tight text-ink">Also Built</h2>
  <div class="mt-10 grid grid-cols-1 gap-y-14 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-16">
    {secondaryProjects.map((project, idx) => (
      <ProjectCard
        {...project}
        index={projects.length + idx + 1}
        category="EXPERIMENT"
        headingLevel="h3"
      />
    ))}
  </div>
</Base>