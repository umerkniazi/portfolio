---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.ts';
import { skills } from '../data/skills.ts';
import { environment } from '../data/environment.ts';
---

<Base title="About" description={`About ${site.name}.`}>
  <h1 class="text-3xl font-bold tracking-tight text-ink">About</h1>

  <div class="mt-6 flex max-w-[60ch] flex-col gap-4 text-sm leading-relaxed text-body">
    {site.bio.about.map((paragraph) => <p>{paragraph}</p>)}
  </div>

  <p class="mt-4 text-sm">
    <a href={`mailto:${site.email}`} class="text-accent underline-offset-4 hover:underline">Email me →</a>
  </p>

  <section class="mt-14 border-t border-border pt-8 sm:mt-16" aria-labelledby="education-heading">
    <h2 id="education-heading" class="font-mono text-xs font-semibold uppercase tracking-widest text-muted">Education</h2>
    <div class="mt-4 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <p class="text-sm font-semibold text-ink">
        {site.education.degree} <span class="font-normal text-faint">— {site.education.school}</span>
      </p>
      <p class="font-mono text-xs text-faint">{site.education.period}</p>
    </div>
  </section>

  <div class="mt-14 grid grid-cols-1 gap-12 border-t border-border pt-8 sm:mt-16 sm:grid-cols-2 sm:gap-10">
    <section aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="font-mono text-xs font-semibold uppercase tracking-widest text-muted">Skills</h2>
      <div class="mt-6 flex flex-col gap-6">
        {
          skills.map((group) => (
            <div class="flex flex-col gap-1.5">
              <h3 class="font-mono text-[11px] font-medium uppercase tracking-wider text-faint">{group.category}</h3>
              <p class="font-mono text-sm leading-relaxed text-body">
                {group.items.join(' · ')}
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="interests-heading">
      <h2 id="interests-heading" class="font-mono text-xs font-semibold uppercase tracking-widest text-muted">Interests</h2>
      <p class="mt-6 font-mono text-sm leading-relaxed text-body">{site.interests.join(' · ')}</p>
    </section>
  </div>

  <section class="mt-14 border-t border-border pt-8 sm:mt-16" aria-labelledby="environment-heading">
    <h2 id="environment-heading" class="font-mono text-xs font-semibold uppercase tracking-widest text-muted">Setup</h2>
    <p class="mt-2 text-sm text-body">What I actually build with, day to day.</p>
    <dl class="mt-8 grid grid-cols-1 gap-y-6 sm:grid-cols-2 sm:gap-x-10 sm:gap-y-8">
      {
        environment.map((group) => (
          <div class="flex flex-col gap-1.5 border-t border-border/40 pt-3">
            <dt class="font-mono text-[11px] font-medium uppercase tracking-wider text-muted">{group.category}</dt>
            <dd class="font-mono text-sm leading-relaxed text-body">{group.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>