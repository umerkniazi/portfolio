---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site.ts';

const path = new URL(Astro.request.url).pathname.replace(/\/index\.html$/, '');

const links = [
  { href: '/', label: 'home' },
  { href: '/projects', label: 'projects' },
  { href: '/about', label: 'about' },
  { href: site.resumeUrl, label: 'resume', external: true },
];

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path.startsWith(href);
}
---

<header class="relative z-40 border-b border-border bg-bg py-6">
  <div class="flex w-full items-center justify-between">
    <a href="/" class="group py-2 text-base font-semibold tracking-tight text-ink no-underline">
      <span class="text-faint transition-colors duration-150 group-hover:text-accent font-normal">~/</span><span class="transition-colors duration-150 group-hover:text-accent">umer</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-6">
      <nav aria-label="Primary" class="hidden items-center gap-6 text-base sm:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              aria-current={!link.external && isActive(link.href) ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-1 px-2 py-2 underline-offset-4 transition-colors duration-150',
                !link.external && isActive(link.href) 
                  ? 'font-medium text-ink underline' 
                  : 'text-muted hover-text-accent hover-underline',
              ]}
            >
              <span>{link.label}</span>
              {link.external && (
                <Icon name="tabler:arrow-up-right" class="h-3.5 w-3.5 opacity-70" aria-hidden="true" />
              )}
            </a>
          ))
        }
      </nav>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle theme"
        class="flex h-11 w-11 items-center justify-center rounded-none text-muted transition-colors duration-150 hover-text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
      >
        <div class="relative flex h-5 w-5 items-center justify-center">
          <Icon name="tabler:moon" class="theme-icon-moon icon-swap absolute h-5 w-5" aria-hidden="true" />
          <Icon name="tabler:sun" class="theme-icon-sun icon-swap absolute h-5 w-5" aria-hidden="true" />
        </div>
      </button>

      <button
        type="button"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Open menu"
        class="-mr-1.5 flex h-12 w-12 items-center justify-center rounded-none text-muted hover-text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent sm:hidden"
      >
        <div class="relative flex h-6 w-6 items-center justify-center">
          <Icon name="tabler:menu-2" data-icon="open" class="icon-swap absolute h-6 w-6" aria-hidden="true" />
          <Icon name="tabler:x" data-icon="close" class="icon-swap icon-hidden absolute h-6 w-6" aria-hidden="true" />
        </div>
      </button>
    </div>
  </div>

  <nav
    id="nav-mobile"
    aria-label="Primary"
    inert
    class="absolute left-0 top-full flex w-full flex-col gap-2 border-b border-border bg-bg pb-4 pt-2 text-base sm:hidden"
  >
    {
      links.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          aria-current={!link.external && isActive(link.href) ? 'page' : undefined}
          class:list={[
            'flex items-center justify-between rounded-none px-5 py-3.5 underline-offset-4 transition-colors duration-150',
            !link.external && isActive(link.href) 
              ? 'font-medium text-ink underline' 
              : 'text-muted hover-text-accent hover-underline',
          ]}
        >
          <span>{link.label}</span>
          {link.external && (
            <Icon name="tabler:arrow-up-right" class="h-4 w-4 opacity-70" aria-hidden="true" />
          )}
        </a>
      ))
    }
  </nav>
</header>

<script>
  let globalNavListenersBound = false;

  function initThemeToggle() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    toggle.addEventListener('click', () => {
      const element = document.documentElement;
      const isDark =
        element.classList.contains('dark') ||
        (!element.classList.contains('light') && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const nextIsDark = !isDark;
      element.classList.toggle('dark', nextIsDark);
      element.classList.toggle('light', !nextIsDark);
      try {
        localStorage.setItem('theme', nextIsDark ? 'dark' : 'light');
      } catch (e) {}
    });
  }

  function initNavToggle() {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('nav-mobile');
    if (!toggle || !panel || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    const iconOpen = toggle.querySelector('[data-icon="open"]');
    const iconClose = toggle.querySelector('[data-icon="close"]');

    function setOpen(open: boolean) {
      if (!toggle || !panel) return;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.classList.toggle('nav-mobile-open', open);
      panel.toggleAttribute('inert', !open);

      iconOpen?.classList.toggle('icon-hidden', open);
      iconClose?.classList.toggle('icon-hidden', !open);
    }

    toggle.addEventListener('click', () => {
      const isOpening = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(isOpening);
      
      if (isOpening) {
        requestAnimationFrame(() => {
          const firstLink = panel.querySelector('a');
          firstLink?.focus();
        });
      } else {
        toggle.focus();
      }
    });

    panel.addEventListener('click', (e) => {
      if (e.target instanceof HTMLElement && e.target.tagName === 'A') setOpen(false);
    });

    if (!globalNavListenersBound) {
      globalNavListenersBound = true;

      document.addEventListener('click', (e) => {
        const t = document.getElementById('nav-toggle');
        const p = document.getElementById('nav-mobile');
        if (!t || !p || t.getAttribute('aria-expanded') !== 'true') return;
        if (!(e.target instanceof Node)) return;
        if (!t.contains(e.target) && !p.contains(e.target)) {
          setOpen(false);
          t.focus();
        }
      });

      document.addEventListener('keydown', (e) => {
        const t = document.getElementById('nav-toggle');
        if (e.key === 'Escape' && t && t.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          t.focus();
        }
      });

      const desktopQuery = window.matchMedia('(min-width: 640px)');
      desktopQuery.addEventListener('change', (e) => {
        const t = document.getElementById('nav-toggle');
        if (e.matches && t && t.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
        }
      });
    }
  }

  function initScripts() {
    initThemeToggle();
    initNavToggle();
  }

  document.addEventListener('astro:page-load', initScripts);
</script>